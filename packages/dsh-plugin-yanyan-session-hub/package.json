{
  "name": "dsh-plugin-yanyan-session-hub",
  "version": "1.0.1",
  "description": "会话管理中心（Phase 1）：旁路元数据存储（标签/文件夹/自定义标题），左中右三栏 UI 骨架，不改动 DSH 原生会话文件。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "icon.svg", "locale/en.json", "locale/zh.json", "README.md", "README.zh.md"],
  "keywords": ["deepseek-harness", "dsh-plugin", "session-hub", "tags", "folders", "cordis"],
  "author": "sweet560",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweet560/dsh-plugin-yanyan-toolkit.git",
    "directory": "packages/dsh-plugin-yanyan-session-hub"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": { "test": "node --test test/*.test.mjs" },
  "dsh": {
    "engines": { "dsh": ">=0.2.2-rc.3" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["slots", "locale", "connection", "sessions"], "platform": "web" },
    "manifestVersion": 1
  }
}
