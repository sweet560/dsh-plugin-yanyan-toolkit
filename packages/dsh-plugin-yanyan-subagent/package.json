{
  "name": "dsh-plugin-yanyan-subagent",
  "version": "1.2.0",
  "description": "子智能体管理：查看、彻底删除（日志根除）、批量清理空闲与自动清理、清理残留行",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib/index.js","lib/client.js","lib/log-rewrite.js","lib/zstd-frames.js","lib/legacy-hidden-ids.json","cordis.patch.yml","icon.svg","locale/en.json","locale/zh.json","README.md","README.zh.md"],
  "keywords": ["deepseek-harness","dsh-plugin","subagent","cleanup","session-log","cordis"],
  "author": "sweet560",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweet560/dsh-plugin-yanyan-toolkit.git",
    "directory": "packages/dsh-plugin-yanyan-subagent"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": { "test": "node --test test/*.test.mjs" },
  "dsh": {
    "engines": { "dsh": ">=0.2.2-rc.2" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["locale","sessions","slots"], "platform": "web" },
    "manifestVersion": 1
  }
}
